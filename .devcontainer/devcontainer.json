{
  "name": "Python 3",
  // GitHub Codespaces only; production does not use containers (Render runs Python).
  // 3.12 matches the project (.python-version, used by CI; PYTHON_VERSION in render.yaml).
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "frontend/streamlit_app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  // Pinned versions only (the same files CI and Render install).
  "updateContentCommand": "pip3 install --user -r requirements.txt -r frontend/requirements.txt && echo '✅ Requirements installed'",
  // XSRF and CORS protection stay on: the app has no file uploads that would need them off.
  // Set API_BASE_URL as a Codespaces secret (or in .streamlit/secrets.toml) to reach the API.
  "postAttachCommand": {
    "server": "streamlit run frontend/streamlit_app.py"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}