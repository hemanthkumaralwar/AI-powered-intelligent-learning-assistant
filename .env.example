# Copy to .env and fill in. Never commit .env, and never put real keys in this file.
APP_NAME=ArchintX Learning Assistant
# development | test | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL (uppercase)
LOG_LEVEL=INFO

# LLM provider: gemini | openai | fake (fake = offline canned replies; refused in production)
LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Extra tokens Gemini may spend thinking before answering (0 = off, fastest)
GEMINI_THINKING_BUDGET=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
# Total tries per request, including the first (1-5)
LLM_MAX_ATTEMPTS=3

# Database (PostgreSQL). Neon: use the DIRECT connection string (not "-pooler").
# Supabase (production): use the SESSION pooler URL (port 5432), set on Render only.
DATABASE_URL=
# Neon "test" branch; database tests create and drop their own schema in it
TEST_DATABASE_URL=
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_SECONDS=10

# Embeddings: gemini | openai | huggingface (local only, needs requirements-local.txt) | fake
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Gemini and OpenAI only; Hugging Face uses its model's native size
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=100
EMBEDDING_REQUESTS_PER_MINUTE=60
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_ATTEMPTS=3
