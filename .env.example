# Copy to .env and fill in. Never commit .env, and never put real keys in this file.
APP_NAME=ArchintX Learning Assistant
# development | test | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL (uppercase)
LOG_LEVEL=INFO

# LLM provider: gemini | openai | fake (fake = offline canned replies; refused in production)
LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Extra tokens Gemini may spend thinking before answering (0 = off, fastest)
GEMINI_THINKING_BUDGET=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
# Total tries per request, including the first (1-5)
LLM_MAX_ATTEMPTS=3
