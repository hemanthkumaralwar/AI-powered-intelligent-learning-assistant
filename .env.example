# Copy to .env and fill in. Never commit .env, and never put real keys in this file.
APP_NAME=ArchintX Learning Assistant
# development | test | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL (uppercase)
LOG_LEVEL=INFO

# LLM provider: gemini | openai | fake (fake = offline canned replies; refused in production)
LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Extra tokens Gemini may spend thinking before answering (0 = off, fastest).
# "default" sends no thinking setting; *-lite models (e.g. gemini-3.5-flash-lite) need it.
GEMINI_THINKING_BUDGET=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
# Total tries per request, including the first (1-5)
LLM_MAX_ATTEMPTS=3

# Grounded answers (measured in eval/reports; see README)
RAG_TOP_K=5
RAG_MIN_SCORE=0.63
CHAT_QUESTIONS_PER_USER_PER_MINUTE=5
CHAT_QUESTIONS_GLOBAL_PER_MINUTE=20

# Database (PostgreSQL). Neon: use the DIRECT connection string (not "-pooler").
# Supabase (production): use the SESSION pooler URL (port 5432), set on Render only.
DATABASE_URL=
# Neon "test" branch; database tests create and drop their own schema in it
TEST_DATABASE_URL=
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_SECONDS=10

# Auth. Signs access tokens; 32+ characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=60
# Optional first admin, created at startup only if the username does not exist yet.
# Choose your own; ADMIN_PASSWORD needs 12+ characters. Set both or neither.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Code runner: remote sandboxes tried in order (judge0 | godbolt | fake for dev/tests)
CODE_RUNNERS=judge0,godbolt
JUDGE0_BASE_URL=https://ce.judge0.com
GODBOLT_BASE_URL=https://godbolt.org
CODE_RUNNER_TIMEOUT_SECONDS=30
CODE_CPU_SECONDS=5
CODE_WALL_SECONDS=10
CODE_RUNS_PER_USER_PER_MINUTE=10
CODE_RUNS_PER_USER_PER_DAY=200
CODE_RUNS_GLOBAL_PER_MINUTE=30

# Embeddings: gemini | openai | huggingface (local only, needs requirements-local.txt) | fake
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Gemini and OpenAI only; Hugging Face uses its model's native size
EMBEDDING_DIMENSIONS=768
# Gemini's free tier meters every text: ~100/minute and ~1,000/day per project.
# Indexing and student questions get separate per-minute budgets (together under 100).
EMBEDDING_BATCH_SIZE=40
EMBEDDING_DOCUMENT_TEXTS_PER_MINUTE=80
EMBEDDING_QUERY_TEXTS_PER_MINUTE=20
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_ATTEMPTS=3
